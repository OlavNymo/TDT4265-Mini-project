# Data files - never commit data to repository
data/*
!data/.gitkeep
!data/processed/.gitkeep

# Results and models

# Ignore all media files in results directory
results/**/*.jpg
results/**/*.jpeg
results/**/*.png
results/**/*.json
results/**/events.out.tfevents.*
results/**/temp_*

# PyTorch model files - keep only best.pt
*.pt
!results/**/best.pt
!results/models/*.pt

# Large files
*.h5
*.pth
*.onnx
*.tflite
*.pb
*.whl
flash_attn-*.whl

# Specifically exclude the large file that caused issues
flash_attn-2.7.3+cu11torch2.2cxx11abiFALSE-cp311-cp311-linux_x86_64.whl
